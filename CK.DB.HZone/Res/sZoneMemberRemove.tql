-- SetupConfig: {}
create transformer on CK.sZoneMemberRemove
as
begin
	add parameter @AutoRemoveMemberFromChildZone bit = 1;

	inject "
	if @AutoRemoveMemberFromChildZone = 1
	begin
        --<PreRemoveMemberFromChildZone revert/>

		-- Retrieves the parent hierarchical identifier.
		declare @ParentHID hierarchyid;
		select @ParentHID = z.HierarchicalId from CK.tZone z where z.ZoneId = @ZoneId;
		-- Removes the member from child zones from deepest to direct children.
		declare @ChildZoneId int;
		declare @CZone cursor;
		set @CZone = cursor local fast_forward for 
						select z.ZoneId
							from CK.tZone z with(serializable)
							where z.HierarchicalId.IsDescendantOf( @ParentHID ) = 1
							order by z.HierarchicalId.GetLevel() desc;
		open @CZone;
		fetch from @CZone into @ChildZoneId;
		while @@FETCH_STATUS = 0
		begin
			if @ChildZoneId <> @ZoneId
			begin
				exec CK.sZoneMemberRemove @ActorId, @ChildZoneId, @MemberId, 0;
			end
			fetch next from @CZone into @ChildZoneId;
		end
		deallocate @CZone;

        --<PostRemoveMemberFromChildZone />
	end" 
	into "PreZoneMemberRemove";

	-- This ensures that Zones are skipped while removing the
	-- member from the zones's groups.
	-- This enforces @AutoRemoveMemberFromChildZone semantics and
	-- avoids call recursion since sGroupMemberRemove calls sZoneMemberRemove 
	-- when the group is a zone.
	in single statement {set @CGroup = cursor}
    begin
	    in first part {select}
	    begin
		    inject "not exists(select * from CK.tZone where ZoneId = a.GroupId) and "
               before single {g.ZoneId = @ZoneId};
	    end
    end


end

