-- SetupConfig: { "AddRequires": [ "CK.sZoneMemberRemove" ] }
create transformer on CK.sGroupMemberRemove
as 
begin
	
	inject "
	-- if the group is actually a Zone, calls sZoneMemberRemove
	if exists( select * from CK.tZone where ZoneId = @GroupId )
	begin
		exec CK.sZoneMemberRemove @ActorId, @GroupId, @MemberId;
	end
	else
	begin
	" after single "--[beginsp]";

	inject "
	end
	" before single "--[endsp]";
end
