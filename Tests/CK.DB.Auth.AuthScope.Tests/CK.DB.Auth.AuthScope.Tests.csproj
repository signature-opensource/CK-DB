<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Tombstone: no assembly, no dependencies. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- NU5128: the package has no lib/ folder, on purpose. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- The test helper package stays packable (its former versions are published). -->
    <IsPackable>true</IsPackable>
    <IsTestProject>false</IsTestProject>
    <Description>Deprecated (see its README).</Description>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="MSBuild/CK.DB.Auth.AuthScope.Tests.targets">
      <Pack>true</Pack>
      <PackagePath>buildTransitive\CK.DB.Auth.AuthScope.Tests.targets</PackagePath>
    </Content>
  </ItemGroup>
</Project>
