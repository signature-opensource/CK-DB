<configuration>
    <packageSources>
        <clear />
        <add key="Signature-OpenSource" value="https://pkgs.dev.azure.com/Signature-OpenSource/Feeds/_packaging/NetCore3/nuget/v3/index.json" />
        <add key="NuGet" value="https://api.nuget.org/v3/index.json" />
        <add key="Local" value="C:\dev2\CK\.PublicStack\$Local\NuGet" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="Signature-OpenSource">
            <package pattern="*" />
        </packageSource>
        <packageSource key="NuGet">
            <package pattern="*" />
        </packageSource>
        <packageSource key="Local">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
