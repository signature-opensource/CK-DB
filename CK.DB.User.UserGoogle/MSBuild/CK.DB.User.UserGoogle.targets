<Project>
  <Target Name="CK_DB_User_UserGoogle_IsDeprecated" BeforeTargets="ResolveAssemblyReferences">
    <Error Code="CKDEPRECATED"
           Text="Package 'CK.DB.User.UserGoogle' is deprecated: the remote logins are the OpenID Connect schemes of 'CK.DB.User.UserOidc' (the accounts of this provider are not migrated): see https://github.com/signature-opensource/CK-DB/tree/stable/CK.DB.User.UserOidc. See the migration guide https://github.com/signature-opensource/CK-Stack/blob/main/Docs/Migrations/v2026.282-to-explo-cris-auth.md." />
  </Target>
</Project>
